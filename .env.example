# Postgres connection string (Neon, Supabase, RDS, or local Docker).
DATABASE_URL="postgresql://user:password@host:5432/pg1_checklists?sslmode=require"

# 32+ character random string. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Photo storage.
# Set a Vercel Blob token in production. With it empty, photos are written to
# local disk (UPLOAD_DIR, default ./.uploads) and served via /api/files/… —
# fine for development, but not for a multi-instance or serverless deployment.
BLOB_READ_WRITE_TOKEN=""
UPLOAD_DIR=""
