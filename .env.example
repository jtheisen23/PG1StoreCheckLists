# Postgres connection string (Neon, Supabase, RDS, or local Docker).
DATABASE_URL="postgresql://user:password@host:5432/pg1_checklists?sslmode=require"

# 32+ character random string. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Photo storage: "database" (default), "blob", or "local".
# database — photo bytes in Postgres. Nothing else to provision and it works on
#            serverless. Photos are downscaled on the device before upload.
# blob     — Vercel Blob; selected automatically when a token is set. Use this
#            once photo volume outgrows the database.
# local    — files under UPLOAD_DIR. Development convenience only.
PHOTO_STORAGE=""
BLOB_READ_WRITE_TOKEN=""
UPLOAD_DIR=""
